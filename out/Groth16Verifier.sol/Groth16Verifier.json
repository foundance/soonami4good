^2 == x^3 + 3 (mod Q_MOD),         and G2 constants (BETA, GAMMA, DELTA) are valid F_q^2 twist points with DELTA != GAMMA. Audit Fixes Applied:   SV-01..SV-13 \\u2013 Previous fixes preserved   SV-14        \\u2013 Replaced synthetic off-curve constants with algebraically valid BN254 curve points   SV-18        \\u2013 Rejects point-at-infinity (0,0) on proof elements A, B, C and skips 0x07 when input[i] == 0\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"zk-email/contracts/Groth16Verifier.sol\":\"Groth16Verifier\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[],\"viaIR\":true},\"sources\":{\"zk-email/contracts/Groth16Verifier.sol\":{\"keccak256\":\"0x21c0e99e1af7b85d080f7526ebfbf236ca3a0d53dc4afb1805691d8502ebacf5\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://273367a097fff0db7bb498afd36c918f7790488db9e64a3083b0fdea63043971\",\"dweb:/ipfs/QmP5YU7DWusD923NUqR63hpTC5LczNfsDLkDEEXxJSnvuM\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.24+commit.e11b9ed9"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"uint256[2]","name":"a","type":"uint256[2]"},{"internalType":"uint256[2][2]","name":"b","type":"uint256[2][2]"},{"internalType":"uint256[2]","name":"c","type":"uint256[2]"},{"internalType":"uint256[10]","name":"input","type":"uint256[10]"}],"stateMutability":"view","type":"function","name":"verifyProof","outputs":[{"internalType":"bool","name":"r","type":"bool"}]}],"devdoc":{"kind":"dev","methods":{"verifyProof(uint256[2],uint256[2][2],uint256[2],uint256[10])":{"params":{"a":"Proof.A","b":"Proof.B","c":"Proof.C","input":"Public inputs [panelMerkleRoot, dkimPubkeyHash, pk0, pk1, pk2, pk3, publicSeatId, coiFlag, electionEpoch, seatNullifier]"}}},"version":1},"userdoc":{"kind":"user","methods":{"verifyProof(uint256[2],uint256[2][2],uint256[2],uint256[10])":{"notice":"Verifies a Groth16 proof over BN254 against 10 public inputs."}},"versi